      "custom": {
        "description": "Instrument baseplate envelope, 300 x 220 x 45 mm.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "A thick plate is the classic gyroid-infill case: solid faces where things bolt on, graded infill everywhere else.",
        "schema_version": 1,
        "code": "result = cq.Workplane('XY').box(L, W, T)\n",
        "parameters": "",
        "param_1_name": "L",
        "param_1_value": 300.0,
        "param_2_name": "W",
