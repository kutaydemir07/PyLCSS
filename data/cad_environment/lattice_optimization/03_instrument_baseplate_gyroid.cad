  "_title": "Satellite Optical Instrument Baseplate - Gyroid TPMS",
  "_purpose": "Sheet-mode Gyroid TPMS infill optimization for a satellite optical bench baseplate requiring high specific stiffness and thermal dissipation.",
  "_fidelity": "Marching cubes level-set evaluation with calibrated density-to-band transfer, adaptive sub-pitch wall preservation, and solid boss attachments.",
  "_visual_target": "Continuous bicontinuous gyroid channels; solid mounting bosses and perimeter rim; no internal powder-trapping dead ends.",
  "_engineering_decision": "Determine gyroid triply periodic minimal surface (TPMS) infill to satisfy 120 Hz fundamental frequency requirement with minimal launch mass.",
  "_baseline": "Unsolved primary simultaneous-load scenario. Targets are requirements, not measured results.",
  "_design_variables": [
    "Cell size: 12 mm",
    "Target relative density: 22%",
    "Skin thickness: 1.2 mm",
    "Adaptive sub-cell solid: True"
  ],
  "_load_cases": [
    "LC1 Normal 2.94 kN"
  ],
  "_requirements": [
    {
      "requirement": "Primary load response",
      "target": "Review compliance and convergence",
      "verification": "Topology solver objective and change histories",
      "baseline_status": "Not evaluated"
    },
    {
      "requirement": "Preserved interfaces and keep-out regions",
      "target": "Preserved solid material retained; obstacles remain void",
      "verification": "Non-design & Obstacles report and reconstructed geometry inspection",
      "baseline_status": "Not evaluated"
    },
    {
      "requirement": "Structural validation",
      "target": "Meet application-specific stress and displacement limits",
      "verification": "Enable structural verification; inspect the CalculiX validation result",
      "baseline_status": "Not evaluated"
    }
  ],
  "_deliverables": [
    "Optimized density and reconstructed geometry",
    "Objective and design-change histories",
    "Non-design and obstacle region report",
    "Validated stress and displacement only when verification is enabled and succeeds"
  ],
  "_workflow": [
    "Preview the domain, supports and primary load scenario.",
    "Inspect the non-design bodies and obstacles connected to the solver.",
    "Run the topology solver; all connected loads act together.",
    "Review density, reconstructed geometry, region counts and convergence in Results.",
    "Run separate copies for other operating cases; enable structural validation before interpreting validated stress or displacement."
  ],
  "_acceptance_criteria": [
    "Review convergence and final material fraction.",
    "Check interface continuity and obstacle clearance in reconstructed geometry.",
    "Run independent structural verification and refinement before assessing engineering targets."
  ]
