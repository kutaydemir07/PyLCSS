      "custom": {
        "description": "Four bolted mounting feet on the underside.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "The baseplate is kinematically located on four deck hard points; everything between them is the optimizer's.",
        "schema_version": 1,
        "code": "# Four bolted feet on the underside, at the deck hard points.\nresult = None\nfor sx in (-1.0, 1.0):\n    for sy in (-1.0, 1.0):\n        foot = cq.Workplane('XY').box(P, P, F)\n        foot = foot.translate((sx * X, sy * Y, -T / 2.0 + F / 2.0))\n        result = foot if result is None else result.union(foot)\n",
        "parameters": "",
        "param_1_name": "P",
        "param_1_value": 55.0,
        "param_2_name": "F",
        "param_2_value": 8.0,
        "param_3_name": "X",
        "param_3_value": 115.0,
        "param_4_name": "Y",
        "param_4_value": 75.0,
        "param_5_name": "T",
        "param_5_value": 45.0,
        "param_6_name": "",
        "param_6_value": 0.0
      }
    },
