      "custom": {
        "description": "Perimeter clamping frame on the manifold side.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "18 mm of solid land round the edge for the seal groove and the clamping bolts.",
        "schema_version": 1,
        "code": "# A perimeter frame on the underside: the plate is clamped to the\n# coolant manifold all the way round its edge.\nouter = cq.Workplane('XY').box(L, W, F)\ninner = cq.Workplane('XY').box(L - 2.0 * B, W - 2.0 * B, F * 2.0)\nresult = outer.cut(inner).translate((0.0, 0.0, -T / 2.0 + F / 2.0))\n",
        "parameters": "",
        "param_1_name": "L",
        "param_1_value": 240.0,
        "param_2_name": "W",
        "param_2_value": 180.0,
        "param_3_name": "F",
        "param_3_value": 6.0,
        "param_4_name": "B",
        "param_4_value": 18.0,
        "param_5_name": "T",
        "param_5_value": 32.0,
        "param_6_name": "",
        "param_6_value": 0.0
      }
    },
