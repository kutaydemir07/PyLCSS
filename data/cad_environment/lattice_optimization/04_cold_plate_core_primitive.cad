  "_title": "High-Power Electronics Cold Plate - Schwarz Primitive TPMS",
  "_purpose": "Liquid-cooled avionics cold plate design using Schwarz P TPMS core with solid boundary skins and integrated manifold interfaces.",
  "_fidelity": "Continuum-level optimization with adaptive skin attachment and sub-cell solid sealing.",
  "_visual_target": "Self-supporting TPMS core with leak-tight solid perimeter walls; pressure containment up to 1.2 MPa.",
  "_engineering_decision": "Optimize Schwarz Primitive core for simultaneous heat conduction and structural pressure containment.",
  "_baseline": "Unsolved primary simultaneous-load scenario. Targets are requirements, not measured results.",
  "_design_variables": [
    "Cell size: 10 mm",
    "Target relative density: 30%",
    "Skin thickness: 1.5 mm",
    "Adaptive sub-cell solid: True"
  ],
  "_load_cases": [
