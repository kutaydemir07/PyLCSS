      "custom": {
        "description": "Two power-module mounting footprints.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "Solid so the module baseplates seat flat and conduct into material rather than onto a lattice wall.",
        "schema_version": 1,
        "code": "# Two power-module footprints on the upper face.\nresult = None\nfor sx in (-1.0, 1.0):\n    pad = cq.Workplane('XY').box(PX, PY, P)\n    pad = pad.translate((sx * X, 0.0, T / 2.0 - P / 2.0))\n    result = pad if result is None else result.union(pad)\n",
        "parameters": "",
        "param_1_name": "PX",
        "param_1_value": 90.0,
        "param_2_name": "PY",
