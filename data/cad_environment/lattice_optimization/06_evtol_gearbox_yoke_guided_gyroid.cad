      "custom": {
        "description": "Tapered 420 x 260 x 160 mm yoke with twin bearing bosses, pin bores, and a service tunnel.",
        "tags": "topology-optimization, evtol, gearbox-yoke, design-domain",
        "notes": "One connected design body; the connected loads act simultaneously.",
        "schema_version": 1,
        "code": "body = (\n    cq.Workplane('YZ', origin=(0.0, 0.50 * H, 0.50 * W))\n    .ellipse(0.45 * H, 0.43 * W)\n    .workplane(offset=0.55 * L)\n    .ellipse(0.38 * H, 0.36 * W)\n    .workplane(offset=0.27 * L)\n    .ellipse(0.30 * H, 0.29 * W)\n    .loft(combine=True)\n)\nroot = (\n    cq.Workplane('XY')\n    .box(0.10 * L, 0.94 * H, 0.94 * W, centered=(False, False, False))\n    .translate((0.0, 0.03 * H, 0.03 * W))\n)\nupper = (\n    cq.Workplane('YZ', origin=(0.76 * L, 0.70 * H, 0.50 * W))\n    .ellipse(0.155 * H, 0.25 * W)\n    .extrude(0.24 * L)\n)\nlower = (\n    cq.Workplane('YZ', origin=(0.76 * L, 0.30 * H, 0.50 * W))\n    .ellipse(0.155 * H, 0.25 * W)\n    .extrude(0.24 * L)\n)\nresult = body.union(root).union(upper).union(lower)\ntunnel = (\n    cq.Workplane('YZ', origin=(0.13 * L, 0.50 * H, 0.50 * W))\n    .ellipse(0.16 * H, 0.22 * W)\n    .extrude(0.61 * L)\n)\nupper_bore = (\n    cq.Workplane('YZ', origin=(0.78 * L, 0.70 * H, 0.50 * W))\n    .ellipse(0.058 * H, 0.108 * W)\n    .extrude(0.22 * L)\n)\nlower_bore = (\n    cq.Workplane('YZ', origin=(0.78 * L, 0.30 * H, 0.50 * W))\n    .ellipse(0.058 * H, 0.108 * W)\n    .extrude(0.22 * L)\n)\nresult = result.cut(tunnel).cut(upper_bore).cut(lower_bore)\n\nresult = result.intersect(root.union(upper).union(lower))\n",
        "parameters": "",
        "param_1_name": "L",
        "param_1_value": 420.0,
        "param_2_name": "H",
        "param_2_value": 260.0,
        "param_3_name": "W",
        "param_3_value": 160.0,
        "param_4_name": "hole_d",
        "param_4_value": 6.0,
        "param_5_name": "fillet_r",
        "param_5_value": 1.0,
        "param_6_name": "clearance",
        "param_6_value": 0.2
      }
    },
