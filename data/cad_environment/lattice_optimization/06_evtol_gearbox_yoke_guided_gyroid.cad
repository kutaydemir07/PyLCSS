  "_title": "eVTOL Rotor Gearbox Yoke - Guided Gyroid Lattice",
  "_purpose": "Advanced urban air mobility (eVTOL) gearbox suspension yoke subjected to the primary 2.5g thrust scenario.",
  "_fidelity": "Linear elastic voxel compliance optimization with Gyroid Lattice, Guided cell/member sizing, and explicitly connected preserved and obstacle CAD bodies.",
  "_visual_target": "Solid bearing races and fuselage root; smooth graded Gyroid lattice transition; zero open voids.",
  "_engineering_decision": "Verify multi-axis flight load transfer across a 3D printed Ti-6Al-4V rotor yoke with graded Gyroid infill.",
  "_baseline": "Unsolved primary simultaneous-load scenario. Targets are requirements, not measured results.",
  "_design_variables": [
    "Envelope volume fraction: 32%",
    "Minimum member size: 0 mm (0 uses Guided sizing)",
    "Lattice cell/member sizes: Guided",
    "Skin thickness: 0 mm",
    "Lattice relative density: Program Controlled (Conservative)"
  ],
  "_load_cases": [
    "2.5g Thrust Resultant"
  ],
