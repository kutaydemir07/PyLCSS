      "custom": {
        "description": "Bolted interface to the launch-vehicle payload adapter ring.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "32 mm of solid: enough for the bolts to bear on material, and enough to restrain a whole lattice cell. A pad shallower than one cell leaves the truss surrogate with nodes it cannot hold, and the study reports an axial mechanism rather than a stiffness.",
        "schema_version": 1,
        "code": "result = cq.Workplane('XY').box(SX, SY, SZ).translate((OX, OY, OZ))\n",
        "parameters": "",
        "param_1_name": "SX",
