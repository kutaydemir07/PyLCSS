      "custom": {
        "description": "Solid perimeter land, 12 mm wide, full core depth.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "A sandwich panel needs a solid edge close-out to take the attachment bolts and to close the core.",
        "schema_version": 1,
        "code": "# The panel is bolted to the structure all the way round its edge.\nouter = cq.Workplane('XY').box(L, W, T)\ninner = cq.Workplane('XY').box(L - 2.0 * B, W - 2.0 * B, T * 2.0)\nresult = outer.cut(inner)\n",
        "parameters": "",
        "param_1_name": "L",
        "param_1_value": 420.0,
        "param_2_name": "W",
        "param_2_value": 320.0,
        "param_3_name": "B",
        "param_3_value": 12.0,
        "param_4_name": "T",
        "param_4_value": 32.0,
        "param_5_name": "",
        "param_5_value": 0.0,
        "param_6_name": "",
        "param_6_value": 0.0
      }
    },
