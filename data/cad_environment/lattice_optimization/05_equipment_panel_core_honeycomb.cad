      "custom": {
        "description": "Two equipment-box footprints on the upper face.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "Solid inserts under the bolt patterns; a honeycomb cell cannot take a bolt on its own. Kept small on purpose: preserved material is spent out of the same budget the core has to live on, and a generous pad leaves the optimizer nothing to decide.",
        "schema_version": 1,
        "code": "# Two equipment boxes bolted through the upper facesheet.\nresult = None\nfor sx in (-1.0, 1.0):\n    pad = cq.Workplane('XY').box(PX, PY, P)\n    pad = pad.translate((sx * X, 0.0, T / 2.0 - P / 2.0))\n    result = pad if result is None else result.union(pad)\n",
        "parameters": "",
        "param_1_name": "PX",
        "param_1_value": 100.0,
        "param_2_name": "PY",
        "param_2_value": 80.0,
        "param_3_name": "P",
        "param_3_value": 6.0,
        "param_4_name": "X",
        "param_4_value": 95.0,
        "param_5_name": "T",
        "param_5_value": 32.0,
        "param_6_name": "",
        "param_6_value": 0.0
      }
    },
