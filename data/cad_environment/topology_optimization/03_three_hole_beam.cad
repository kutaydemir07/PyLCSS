      "subgraph_session": {},
      "custom": {
        "code": "# Rectangular stock; both left holes are supports, the right hole is loaded.\nresult = cq.Workplane('XY').box(L, H, T)\ncenters = [(-L/2+25, H/2-20), (-L/2+25, -H/2+20), (L/2-25, 0)]\ntags = ['left_upper_bore', 'left_lower_bore', 'right_load_bore']\nfor cx, cy in centers:\n    bore = cq.Workplane('XY').center(cx, cy).circle(D/2).extrude(T+2)\n    result = result.cut(bore.translate((0, 0, -T/2-1)))\nfor i in range(len(centers)):\n    cx, cy = centers[i]\n    result.faces(cq.NearestToPointSelector((cx, cy, 0))).tag(tags[i])\n",
        "parameters": "",
        "description": "Optimize a rectangular beam with three through-bores: two supported holes on the left and one loaded hole on the right, following the three-interface reference arrangement.",
        "tags": "bundled-example, topology-optimization",
        "schema_version": 1,
        "param_1_name": "L",
        "param_1_value": 180.0,
        "param_2_name": "H",
        "param_2_value": 100.0,
        "param_3_name": "T",
        "param_3_value": 12.0,
        "param_4_name": "D",
        "param_4_value": 16.0,
        "param_5_name": "",
        "param_5_value": 0.0,
        "param_6_name": "",
        "param_6_value": 0.0
      }
