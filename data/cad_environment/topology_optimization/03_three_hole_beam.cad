  "_deliverables": [
    "Optimized density and convergence report",
    "Recovered geometry and interface review"
  ],
  "_acceptance_criteria": [
    "Supports and load remain attached to connected material.",
    "Selected non-design interfaces remain solid and bores stay open.",
    "Compare convergence and geometry on a finer voxel mesh."
  ],
  "_purpose": "Optimize a rectangular beam with three through-bores: two supported holes on the left and one loaded hole on the right, following the three-interface reference arrangement.",
  "_visual_target": "An open branching structure joining the right load collar to the two left support collars. The starting stock remains rectangular.",
  "_engineering_decision": "Find a stiff branching load path at a 35% material budget while retaining all three bore collars.",
  "_design_variables": [
    "Rectangular stock: 180 x 100 x 12 mm",
    "Bores: diameter 16 mm",
    "Left bore centers: (-65, +30) and (-65, -30) mm",
    "Right bore center: (+65, 0) mm",
    "Preserved radial collar wall: 5 mm",
    "Volume fraction: 35%"
  ],
  "_load_cases": [
    "Both left bore walls fixed",
    "Right bore wall: total 1,000 N downward in -Y"
