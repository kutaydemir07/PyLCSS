      ],
      "disabled": false,
      "selected": false,
      "visible": true,
      "width": 229.546875,
      "height": 168.6,
      "pos": [
        -3000.0,
        -900.0
      ],
      "layout_direction": 0,
      "port_deletion_allowed": false,
      "subgraph_session": {},
      "custom": {
        "description": "3600 x 900 x 2200 mm press-crown packaging envelope with tapered end shoulders.",
        "tags": "topology-optimization, engineering-challenge, press-crown, large-structure",
        "notes": "Only material inside this source volume can be redistributed.",
        "schema_version": 1,
        "code": "if min(L, H, W) <= 0.0 or TAPER < 0.0 or 2.0 * TAPER >= L:\n    raise ValueError('Invalid crown envelope dimensions.')\nprofile = [(-L / 2.0, -H / 2.0), (L / 2.0, -H / 2.0), (L / 2.0 - TAPER, H / 2.0), (-L / 2.0 + TAPER, H / 2.0)]\nresult = cq.Workplane('XY').polyline(profile).close().extrude(W / 2.0, both=True)\n",
        "parameters": "",
        "param_1_name": "L",
        "param_1_value": 3600.0,
        "param_2_name": "H",
        "param_2_value": 900.0,
        "param_3_name": "W",
        "param_3_value": 2200.0,
        "param_4_name": "TAPER",
        "param_4_value": 250.0,
        "param_5_name": "fillet_r",
        "param_5_value": 1.0,
        "param_6_name": "clearance",
        "param_6_value": 0.2
      }
    },
    "0x22951e48350": {
      "type_": "com.cad.code_part.CadQueryCodeNode",
      "icon": null,
      "name": "Four Preserved Column Bearing Pads",
      "color": [
        13,
        18,
        23,
        255
      ],
      "border_color": [
        74,
        84,
        85,
        255
      ],
      "text_color": [
        255,
