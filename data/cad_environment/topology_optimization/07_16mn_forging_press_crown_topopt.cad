        255,
        180
      ],
      "disabled": false,
      "selected": false,
      "visible": true,
      "width": 255.8125,
      "height": 168.6,
      "pos": [
        -3000.0,
        -720.0
      ],
      "layout_direction": 0,
      "port_deletion_allowed": false,
      "subgraph_session": {},
      "custom": {
        "description": "Four machined bearing blocks at the column-head interfaces.",
        "tags": "topology-optimization, engineering-challenge, press-crown, interface",
        "notes": "The complete pad volumes are mandatory material; their undersides define the ideal supports.",
        "schema_version": 1,
        "code": "pads = []\nfor x in (-X, X):\n    for z in (-Z, Z):\n        pads.append(cq.Workplane('XY').box(PX, PY, PZ, centered=(True, True, True)).translate((x, -H / 2.0 + PY / 2.0, z)))\nresult = pads[0]\nfor pad in pads[1:]:\n    result = result.union(pad)\n",
        "parameters": "",
        "param_1_name": "X",
        "param_1_value": 1400.0,
        "param_2_name": "Z",
        "param_2_value": 850.0,
        "param_3_name": "PX",
        "param_3_value": 500.0,
        "param_4_name": "PY",
        "param_4_value": 150.0,
        "param_5_name": "PZ",
        "param_5_value": 360.0,
        "param_6_name": "H",
        "param_6_value": 900.0
      }
    },
