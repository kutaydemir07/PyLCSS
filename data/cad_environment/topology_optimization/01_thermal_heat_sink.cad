  "graph": {"layout_direction": 0, "acyclic": true, "pipe_collision": false, "pipe_slicing": true, "pipe_style": 1, "accept_connection_types": "{}", "reject_connection_types": "{}"},
  "nodes": {
    "domain": {
      "type_": "com.cad.geometry.box.BoxNode",
      "name": "Heat Sink Design Domain",
      "pos": [-760.0, -40.0],
      "custom": {
        "length_x": 80.0,
        "width_y": 50.0,
        "height_z": 16.0,
        "centered": true
      }
    },
    "material": {
      "type_": "com.cad.sim.material.MaterialNode",
      "name": "Aluminum 6061-T6",
      "pos": [-420.0, -260.0],
      "custom": {
        "preset": "Aluminum 6061-T6",
        "youngs_modulus": 68900.0,
        "poissons_ratio": 0.33,
        "density": 2.7e-09,
        "thermal_conductivity": 167.0,
        "yield_strength": 240.0,
        "tangent_modulus": 0.0
      }
    },
    "sink-face": {
      "type_": "com.cad.select_face.SelectFaceNode",
      "name": "Select Sink Face",
      "pos": [-520.0, -80.0],
      "custom": {"selector_type": "Direction", "direction": "<X"}
    },
    "heat-face": {
      "type_": "com.cad.select_face.SelectFaceNode",
      "name": "Select Heat Input Face",
      "pos": [-520.0, 120.0],
      "custom": {"selector_type": "Direction", "direction": ">X"}
    },
    "sink": {
      "type_": "com.cad.topopt.thermal_sink.TopologyThermalSinkNode",
      "name": "Thermal Sink",
      "pos": [-260.0, -60.0],
      "custom": {}
    },
    "heat": {
      "type_": "com.cad.topopt.heat_load.TopologyHeatLoadNode",
      "name": "Electronics Heat",
      "pos": [-260.0, 140.0],
      "custom": {"case_name": "Electronics", "total_heat": 100.0, "weight": 1.0}
    },
    "topopt": {
      "type_": "com.cad.sim.topopt_voxel.TopologyOptVoxelNode",
      "name": "Thermal Topology Study",
      "pos": [80.0, -20.0],
      "custom": {
        "workflow_mode": "Guided",
        "design_goal": "Thermal Conduction",
        "physics_mode": "Thermal",
        "manufacturing_process": "Additive",
        "advanced_settings_visible": false,
        "volfrac": 0.35,
        "optimizer": "Auto",
        "max_iter": 40,
        "tol": 0.008,
        "convergence_patience": 4,
        "density_cutoff": 0.35,
        "structure_mode": "Solid Envelope",
        "print_ready_mesh": true,
        "mesh_decimate_ratio": 0.85,
        "surface_recovery_method": "Volume-Preserving SDF (VTK)"
      }
    }
  },
  "connections": [
    {"out": ["domain", "shape"], "in": ["sink-face", "shape"]},
    {"out": ["domain", "shape"], "in": ["heat-face", "shape"]},
    {"out": ["domain", "shape"], "in": ["topopt", "design_domain"]},
    {"out": ["material", "material"], "in": ["topopt", "material"]},
    {"out": ["sink-face", "workplane"], "in": ["sink", "target_region"]},
    {"out": ["heat-face", "workplane"], "in": ["heat", "target_region"]},
    {"out": ["sink", "thermal_sinks"], "in": ["topopt", "thermal_sinks"]},
    {"out": ["heat", "thermal_loads"], "in": ["topopt", "thermal_loads"]}
  ]
}
