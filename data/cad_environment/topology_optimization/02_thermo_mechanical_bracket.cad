    "loaded-face": {
      "type_": "com.cad.select_face.SelectFaceNode",
      "name": "Select Working End",
      "pos": [-560.0, 90.0],
      "custom": {"selector_type": "Direction", "direction": ">X"}
    },
    "support": {
      "type_": "com.cad.topopt.support.TopologySupportNode",
      "name": "Fixed Attachment",
      "pos": [-300.0, -140.0],
      "custom": {"support_type": "Fixed"}
    },
    "force": {
