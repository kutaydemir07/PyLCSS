      "custom": {"preset": "Aluminum 6061-T6", "youngs_modulus": 68900.0, "poissons_ratio": 0.33, "density": 2.7e-09, "thermal_conductivity": 167.0, "yield_strength": 240.0, "tangent_modulus": 0.0}
