      "custom": {
        "description": "Rectangular plate billet, 300 x 200 x 25 mm.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "A 25 mm plate is the stock; the Z-extruded constraint is what makes the result a 2.5-D machined part rather than an unmakeable 3-D shape.",
        "schema_version": 1,
        "code": "# Plate billet the rocker is machined out of. The optimizer is given\n# the whole billet and has to find the arms itself.\nresult = cq.Workplane('XY').box(L, H, T)\n",
        "parameters": "",
        "param_1_name": "L",
        "param_1_value": 300.0,
        "param_2_name": "H",
        "param_2_value": 200.0,
        "param_3_name": "T",
        "param_3_value": 25.0,
        "param_4_name": "",
        "param_4_value": 0.0,
        "param_5_name": "",
        "param_5_value": 0.0,
        "param_6_name": "",
        "param_6_value": 0.0
      }
    },
