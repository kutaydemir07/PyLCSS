  "connections": [
    {"out": ["domain", "shape"], "in": ["fixed-face", "shape"]},
    {"out": ["domain", "shape"], "in": ["loaded-face", "shape"]},
    {"out": ["domain", "shape"], "in": ["topopt", "design_domain"]},
    {"out": ["material", "material"], "in": ["topopt", "material"]},
    {"out": ["fixed-face", "workplane"], "in": ["support", "target_region"]},
    {"out": ["loaded-face", "workplane"], "in": ["force", "target_region"]},
    {"out": ["support", "supports"], "in": ["topopt", "supports"]},
    {"out": ["force", "loads"], "in": ["topopt", "loads"]}
  ]
