  "_title": "GE Sloped Clevis Bracket",
  "_baseline": "Unsolved design domain with all boundary selections supplied.",
  "_fidelity": "Imported reference CAD with its original angles and fillets. The base is aligned to XY and analysis partitions are fused. Linear elastic steel and a single 2 kN load are demonstration choices, rather than a reproduction of all GE challenge load cases. Start with 3 mm voxels.",
  "_requirements": [
    {
      "requirement": "Convergence and material budget",
      "target": "Review convergence at 40% volume fraction",
      "verification": "Objective/change histories and final volume report",
      "baseline_status": "Not evaluated"
    },
    {
      "requirement": "Preserved interfaces",
      "target": "Retain the selected non-design material and open bores",
      "verification": "Non-design face-layer preview and recovered geometry",
      "baseline_status": "Not evaluated"
    }
  ],
  "_workflow": [
    "Preview the domain, named support/load selections and non-design face layers.",
    "Run the TopOpt solver and inspect density, volume fraction and convergence.",
    "Use automatic voxel meshing. Preserve only the screw-hole and middle clevis-bore collars, then recover CAD and run structural verification."
  ],
  "_deliverables": [
    "Optimized density and convergence report",
    "Recovered geometry and interface review"
  ],
  "_acceptance_criteria": [
    "Supports and load remain attached to connected material.",
    "Selected non-design interfaces remain solid and bores stay open.",
    "Compare convergence and geometry on a finer voxel mesh."
  ],
  "_purpose": "Optimize the GE reference bracket matching the supplied plain-bracket layout: four counterbored mounts, two raised clevis lugs, tapered base, angled shoulders and blended lug feet.",
  "_visual_target": "Connected material from the two clevis bores to all four mounts, within the original inclined CAD envelope.",
  "_engineering_decision": "Find a load path in the reference CAD at a 40% material budget for the supplied single demonstration load.",
  "_design_variables": [
    "Reference CAD bounds: 178.54 x 108.32 x 62.50 mm",
    "Two coaxial clevis bores: diameter 19.1135 mm",
    "Original sloped faces and mounting-hole layout retained",
    "Volume fraction: 40%"
  ],
  "_load_cases": [
    "All four lower base bolt bore walls fixed",
    "One total 2,000 N force in global -Z, shared by the two clevis bore walls"
  ],
  "_geometry_source": "https://github.com/fenics-dolfiny/dolfiny/blob/8d3b71645ee1ac44ea78ebe19ad9bbe672575a9f/demo/structural_optimisation/ge_bracket_rotated_nonds.step",
  "_engineering_limits": [
    "Geometry comes from the public GE benchmark provided by dolfiny; source and license texts are in assets/.",
