      "port_deletion_allowed": false,
      "subgraph_session": {},
      "custom": {
        "code": "# Full-span rectangular MBB domain. Coplanar face partitions define\n# small bearing/load pads without changing the rectangular envelope.\ncuts = [-L/2, -L/2+6, -6, 6, L/2-6, L/2]\nresult = None\nfor i in range(len(cuts)-1):\n    a, b = cuts[i], cuts[i+1]\n    block = cq.Workplane('XY').box(b-a, H, T).translate(((a+b)/2, 0, 0))\n    result = block if result is None else result.union(block, clean=False)\nresult.edges(cq.NearestToPointSelector((-L/2, -H/2, 0))).tag('left_pin')\nresult.edges(cq.NearestToPointSelector((L/2, -H/2, 0))).tag('right_roller')\nresult.faces(cq.NearestToPointSelector((0, H/2, 0))).tag('midspan_load')\nresult.faces(cq.NearestToPointSelector((-L/2+3, -H/2, 0))).tag('left_pad')\nresult.faces(cq.NearestToPointSelector((L/2-3, -H/2, 0))).tag('right_pad')\n",
        "parameters": "",
        "description": "Full-span MBB beam with a rectangular design domain, bottom end supports and a downward load on a small top-midspan pad.",
        "tags": "bundled-example, topology-optimization",
        "schema_version": 1,
        "param_1_name": "L",
        "param_1_value": 180.0,
        "param_2_name": "H",
        "param_2_value": 60.0,
        "param_3_name": "T",
        "param_3_value": 12.0,
        "param_4_name": "",
        "param_4_value": 0.0,
        "param_5_name": "",
        "param_5_value": 0.0,
        "param_6_name": "",
        "param_6_value": 0.0
      }
    },
