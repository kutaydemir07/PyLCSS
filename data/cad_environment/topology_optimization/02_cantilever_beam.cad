      "custom": {
        "description": "Rectangular cantilever design domain.",
        "tags": "bundled-example, topology-optimization, pymoto, geometry",
        "notes": "Edit the parameters to rescale the benchmark.",
        "schema_version": 1,
        "code": "# Rectangular cantilever design domain, built in at x = -L/2.\n# The tip load acts on the free-end lower corner, which is the classical\n# arrangement used to produce the Michell-type strut layout.\nresult = cq.Workplane('XY').box(L, H, T)\n",
