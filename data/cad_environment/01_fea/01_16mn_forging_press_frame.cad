  "nodes": {
    "0x16262031460": {
      "type_": "com.cad.code_part.CadQueryCodeNode",
      "icon": null,
      "name": "Continuous Reinforced Press Frame",
      "color": [
        13,
        18,
        23,
        255
      ],
      "border_color": [
        74,
        84,
        85,
        255
      ],
      "text_color": [
        255,
        255,
        255,
        180
      ],
      "disabled": false,
      "selected": false,
      "visible": true,
      "width": 247.6875,
      "height": 168.6,
      "pos": [
        -1450.0,
        -220.0
      ],
      "layout_direction": 0,
      "port_deletion_allowed": false,
      "subgraph_session": {},
      "custom": {
        "description": "One conformal global weldment with hollow columns and tapered load-spreading transitions.",
        "tags": "engineering-challenge, structural-fea, calculix, press-frame, continuous-solid",
        "notes": "This global model intentionally removes numerical assembly ties; detailed weld profiles remain local-submodel work.",
        "schema_version": 1,
        "code": "if min(L, D, BED_H, CROWN_H, COLUMN_W, WALL) <= 0:\n    raise ValueError('All primary frame dimensions must be positive.')\nif 2.0 * WALL >= min(COLUMN_W, column_depth):\n    raise ValueError('Column wall thickness closes the hollow section.')\n\nbed = cq.Workplane('XY').box(L, D, BED_H).translate((0.0, 0.0, BED_H / 2.0))\ncrown = cq.Workplane('XY').box(L, D, CROWN_H).translate((0.0, 0.0, crown_z + CROWN_H / 2.0))\nframe = bed.union(crown)\n\nfor x in (-column_x, column_x):\n    for y in (-column_y, column_y):\n        column_height = column_z1 - column_z0\n        outer = cq.Workplane('XY').box(COLUMN_W, column_depth, column_height).translate((x, y, (column_z0 + column_z1) / 2.0))\n        inner = cq.Workplane('XY').box(COLUMN_W - 2.0 * WALL, column_depth - 2.0 * WALL, column_height + 4.0).translate((x, y, (column_z0 + column_z1) / 2.0))\n        tube = outer.cut(inner)\n        base_plate = cq.Workplane('XY').box(end_plate, end_plate, plate_t).translate((x, y, BED_H + plate_t / 2.0))\n        lower_haunch = cq.Workplane('XY').transformed(offset=(x, y, BED_H + plate_t)).rect(end_plate, end_plate).workplane(offset=haunch_h).rect(COLUMN_W, column_depth).loft(combine=True)\n        upper_haunch = cq.Workplane('XY').transformed(offset=(x, y, crown_z - plate_t - haunch_h)).rect(COLUMN_W, column_depth).workplane(offset=haunch_h).rect(end_plate, end_plate).loft(combine=True)\n        cap_plate = cq.Workplane('XY').box(end_plate, end_plate, plate_t).translate((x, y, crown_z - plate_t / 2.0))\n        frame = frame.union(tube).union(base_plate).union(lower_haunch).union(upper_haunch).union(cap_plate)\n\nfor y in (-column_y, column_y):\n    brace = cq.Workplane('XY').box(brace_length, column_depth, brace_height).translate((0.0, y, brace_z))\n    frame = frame.union(brace)\n\nfor x in (-pad_offset, pad_offset):\n    pad = cq.Workplane('XY').box(pad_length, pad_width, pad_height).translate((x, 0.0, crown_z + CROWN_H + pad_height / 2.0))\n    frame = frame.union(pad)\n\nresult = frame.clean()\n",
        "parameters": "column_depth=400\ncolumn_x=1300\ncolumn_y=700\ncolumn_z0=600\ncolumn_z1=3300\ncrown_z=3500\nend_plate=620\nplate_t=80\nhaunch_h=170\nbrace_length=2220\nbrace_height=300\nbrace_z=2000\npad_offset=450\npad_length=700\npad_width=800\npad_height=160",
        "param_1_name": "L",
        "param_1_value": 3000.0,
        "param_2_name": "D",
        "param_2_value": 1800.0,
        "param_3_name": "BED_H",
        "param_3_value": 400.0,
        "param_4_name": "CROWN_H",
        "param_4_value": 500.0,
        "param_5_name": "COLUMN_W",
        "param_5_value": 400.0,
        "param_6_name": "WALL",
        "param_6_value": 60.0
      }
    },
