  "_title": "EV Multi-Cell Crash Energy Absorber (56 km/h Frontal)",
  "_purpose": "Screen progressive crushing of one six-cell module with an 1850 kg moving wall at 15.56 m/s. This module is not specified to stop the complete sled.",
  "_fidelity": "Nonlinear dynamic explicit shell formulation, elasto-plastic material with DP780 strain hardening, contact self-impact, hourglass stabilization.",
  "_visual_target": "Progressive axial fold pattern without global Euler buckling; kinetic energy converting smoothly to plastic strain dissipation; force-displacement curve.",
  "_engineering_decision": "Verify whether the multi-cell DP780 concept module satisfies progressive folding stability, specific energy absorption (SEA >= 28 kJ/kg), and peak force limits (PCF <= 210 kN) under 56 km/h impact.",
  "_baseline": "Explicit dynamic sled impact with DP780 dual-phase steel.",
  "_design_variables": [
    "Extrusion length: 650 mm",
    "Width: 360 mm",
    "Height: 240 mm",
    "Wall thickness: 0.9 mm"
  ],
  "_load_cases": [
    "1850 kg Sled at 56 km/h Frontal Impact"
  ],
  "_requirements": [
    {
      "requirement": "Specific Energy Absorption (SEA)",
      "target": ">= 28.0 kJ/kg",
      "verification": "Total plastic energy / crushed mass",
      "baseline_status": "Not evaluated; run the stated verification."
    },
    {
      "requirement": "Peak Crash Force (PCF)",
      "target": "<= 210 kN",
      "verification": "Time-history contact force peak",
      "baseline_status": "Not evaluated; run the stated verification."
    },
    {
      "requirement": "Crush Force Efficiency (CFE)",
      "target": ">= 0.65",
      "verification": "Mean force / Peak force ratio",
      "baseline_status": "Not evaluated; run the stated verification."
    },
    {
      "requirement": "Physical Dissipation Share",
      "target": ">= 0.90 of sled kinetic-energy loss",
      "verification": "Physical module energy / (initial minus current sled kinetic energy), with external work and added-mass effects accounted for. This is not 90% of initial sled energy.",
      "baseline_status": "Not evaluated; run the stated verification."
    }
  ],
  "_deliverables": [
    "Deformed animation and available frame fields",
    "Crush-force and energy histories",
    "Crash metrics and energy/quality gate report"
  ],
  "_workflow": [
    "Define multi-cell extrusion profile",
    "Assign DP780 saturating plastic curve",
    "Set 1850 kg barrier mass and 15.56 m/s velocity",
    "Run explicit dynamic crash solver",
    "Inspect fold pattern and open Crash Plot Dialog",
    "Open Results to inspect crash metrics, quality gates and histories; select only frame fields produced by the solver."
  ],
  "_acceptance_criteria": [
    "SEA >= 28 kJ/kg",
    "PCF <= 210 kN",
    "No unphysical hourglass energy accumulation",
    "CFE >= 0.65",
    "Report residual sled kinetic energy at the useful-stroke limit; do not claim a full vehicle stop.",
    "Report added mass, hourglass energy and energy-balance error separately."
  ],
  "_engineering_limits": [
    "Initial sled kinetic energy is 223.955 kJ. At 210 kN peak force and 520 mm useful stroke, module work cannot exceed 109.2 kJ. Residual sled kinetic energy is expected; absorbing 90% of initial sled energy is infeasible with these bounds.",
    "SEA uses stated module mass and useful crush stroke. Distinguish physical energy dissipation from hourglass energy and added mass."
  ]
}
