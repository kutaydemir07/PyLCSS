      "port_deletion_allowed": false,
      "subgraph_session": {},
      "custom": {
        "description": "Conceptual manufacturable six-cell solid for envelope and approximate mass orientation.",
        "tags": "explicit-impact, opencourant, engineering-challenge, ev-crash",
        "notes": "The checked solver deck contains seven geometric trigger bands; this clean solid intentionally omits them.",
        "schema_version": 1,
        "code": "# Conceptual six-cell DP780 extrusion aligned with global X.\n# The checked shell deck contains seven trigger bands; this solid is only the\n# clean manufacturing envelope used for mass and package orientation.\nif min(L, W, H, wall_t) <= 0.0:\n    raise ValueError('All dimensions must be positive.')\nif 2.0 * wall_t >= min(W / 3.0, H / 2.0):\n    raise ValueError('Wall gauge closes a cell.')\ncenter = (0.5 * L, 0.0, 0.0)\nouter = cq.Workplane('XY').box(L, W, H).translate(center)\ninner = cq.Workplane('XY').box(L + 2.0, W - 2.0 * wall_t, H - 2.0 * wall_t).translate(center)\nperimeter = outer.cut(inner)\nweb_left = cq.Workplane('XY').box(L, wall_t, H - 2.0 * wall_t).translate((0.5 * L, -W / 6.0, 0.0))\nweb_right = cq.Workplane('XY').box(L, wall_t, H - 2.0 * wall_t).translate((0.5 * L, W / 6.0, 0.0))\nweb_horizontal = cq.Workplane('XY').box(L, W - 2.0 * wall_t, wall_t).translate(center)\nresult = perimeter.union(web_left).union(web_right).union(web_horizontal)\n",
        "parameters": "",
        "param_1_name": "L",
        "param_1_value": 650.0,
        "param_2_name": "W",
        "param_2_value": 360.0,
        "param_3_name": "H",
        "param_3_value": 240.0,
        "param_4_name": "wall_t",
        "param_4_value": 0.9,
        "param_5_name": "unused_5",
        "param_5_value": 0.0,
        "param_6_name": "unused_6",
        "param_6_value": 0.0
      }
    },
