# Node-owned FreeCAD documents written by the FreeCAD Part bridge
# (pylcss/design_studio/freecad_bridge/paths.py creates this lazily).
# These are per-user design files, not source.
data_freecad/

# Distribution
dist/
build/

# External solver binaries (CalculiX, OpenRadioss) fetched by
# scripts/install_solvers.py — large, platform-specific, and reproducible
# via the script, so don't commit them or the auto-generated path config.
external_solvers/

# Downloaded benchmark decks (e.g. the ~30 MB Neon HPC zip).  Fetched by
# `python scripts/install_solvers.py --with-neon` and reproducible from the
# upstream URL, so we don't commit them.
data/cad_environment/benchmarks/neon/

# Generated experiment and solver outputs
experiments/active_learning/results/
experiments/crash_validation/results/
output/
data/Active Learning Demo Results.json
